{
  "name": "@internal/ui",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch src",
    "check-types": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write \"**/*.ts\""
  },
  "dependencies": {
    "@visual-json/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "7.0.2"
  }
}
