{
	"name": "@visual-json/svelte",
	"version": "0.0.0",
	"scripts": {
	  "prepack": "node ../../../scripts/resolve-workspace-deps.mjs",
    "postpack": "node ../../../scripts/restore-package-json.mjs",
	  "build": "svelte-package --input ./src --output ./dist",
		"check-types": "svelte-check --tsconfig ./tsconfig.json"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"dependencies": {
    "@visual-json/core": "workspace:*",
    "@jsrob/svelte-portal": "^0.2.1"
  },
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
	  "@internal/ui": "workspace:*",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"typescript": "5.9.3",
		"vite": "^6.3.5"
	},
	"keywords": [
		"svelte"
	]
}
